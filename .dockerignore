.venv-*/
__pycache__/
*.pyc
.git/
.gitignore
.dockerignore
Dockerfile

# data, experiments and outputs (the model in models/ IS needed)
data/
mlruns/
mlartifacts/
mlflow.db
logs/
reports/
notebooks/

# dev only
tests/
docs/
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.env
requirements.txt
requirements-lock.txt
